# Never ship node_modules into the build context - it is hundreds of megabytes
# and the image builds its own.
**/node_modules/
**/dist/
**/.vite/

# Python build and test artefacts
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Nothing here belongs in a runtime image
.git/
.github/
docs/
tests/
backend/tests/
chain/
infra/
frontend/screenshots/
frontend/src/design/preview*.png
frontend/src/design/inspect*.png
assets/template/mochibo-original.png

# Secrets must never enter a build context, let alone a layer
**/.env
**/.env.*
**/*.pem
**/*.key

**/.DS_Store
**/Thumbs.db
